# Happy Tour & Travels - Backend Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Replace this demo URI with your real MongoDB Atlas connection string (or local mongodb://localhost:27017/happytravels)
# Example MongoDB Atlas URI: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/happytravels?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://demoUser:demoPassword123@cluster0.demo.mongodb.net/happytravels?retryWrites=true&w=majority

# Cloudinary Credentials (Demo - Update with your real Cloudinary credentials)
# Get yours free at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=demo-cloud-happytravels
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=demo_api_secret_abcdef123456

# JWT Authentication Secret
JWT_SECRET=happytravels_super_secret_jwt_key_2026
